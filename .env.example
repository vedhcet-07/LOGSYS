# ── LLM Providers ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Vector Database ────────────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=logmind-index

# ── Local LLM (Ollama) ────────────────────────────────────────────────────
# Leave empty or set to http://ollama:11434 when using Docker Compose Ollama service
OLLAMA_BASE_URL=

# ── Embedding config ──────────────────────────────────────────────────────
# Must match the Pinecone index dimension (768 for text-embedding-004)
EMBEDDING_DIM=768
EMBEDDING_MODEL=gemini-embedding-001

# ── Application ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
